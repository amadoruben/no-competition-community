# ---------------------------------------------------------------------------
# No Competition Community — environment variables
# Copy to .env.local for local development. Never commit real secrets.
# Server-only unless prefixed NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# development | test | preview | demo | production
APP_ENV=development
# Public base URL (used in password-reset links). Optional locally.
APP_URL=http://localhost:3000

# --- Database (PostgreSQL) --------------------------------------------------
# Runtime connection. Supabase on Vercel: the *transaction pooler* URL (port 6543).
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Any PostgreSQL works: postgres://user:pass@host:5432/db
# Zero-setup local alternative: pglite://data/pglite  (embedded Postgres)
DATABASE_URL=postgres://postgres@localhost:5432/ncc
# Migrations/backups need a direct or session connection (port 5432). Optional;
# falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=
# Apply pending migrations on server start (default: on outside production).
DB_AUTO_MIGRATE=
DATABASE_POOL_MAX=
DATABASE_CONNECT_TIMEOUT_S=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Client-side limit for a query that gets no answer at all (dead connection):
# it fails and the pool discards the connection. Default: statement timeout + 5 s.
DATABASE_QUERY_TIMEOUT_MS=
# Upper bound for each call to Supabase Auth (sign-up includes sending the email),
# and for the session refresh done before every page.
AUTH_TIMEOUT_MS=15000
AUTH_PROXY_TIMEOUT_MS=5000

# --- Authentication: local | supabase -----------------------------------------
AUTH_PROVIDER=local
# Show one-click demo accounts on /login (default: on unless APP_ENV=production).
DEMO_MODE=1

# --- File storage: local | supabase -------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=data/uploads
STORAGE_BUCKET=ncc-files

# --- Supabase (only when a Supabase provider is selected) ------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key — safe in the browser, but the app only uses it server-side.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET. Server-only: storage and identity provisioning. Never expose to the client.
SUPABASE_SECRET_KEY=
# Database password; replaces [YOUR-PASSWORD] in a DATABASE_URL pasted from Supabase → Connect. SECRET.
SUPABASE_DB_PASSWORD=

# --- Email -------------------------------------------------------------------------
# With AUTH_PROVIDER=local the app sends account emails itself with these values.
# With AUTH_PROVIDER=supabase, Supabase sends them: `npm run supabase:auth-config`
# copies SMTP_URL / EMAIL_FROM into the Supabase project (docs/OPERATIONS.md §8).
# SECRET. smtps://user:password@host:465 — URL-encode "@" in the user as %40.
SMTP_URL=
EMAIL_FROM="No Competition Community <no-reply@example.org>"
# Alternative for HTTP-only providers: POST {from, to, subject, text}.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
# Without either, development prints the link to the server log and production refuses.

# Only for `npm run supabase:auth-config` (run locally, never set on Vercel):
# SECRET. Personal token from supabase.com/dashboard/account/tokens — revoke after use.
SUPABASE_ACCESS_TOKEN=
# Extra allowed redirect URLs, comma-separated (e.g. previews: https://<project>-*-<team>.vercel.app/**).
AUTH_REDIRECT_URLS=
# Confirmation/reset emails per hour once custom SMTP is on (Supabase starts at 30).
AUTH_EMAIL_RATE_LIMIT=

# Logging: debug | (default info)
LOG_LEVEL=
