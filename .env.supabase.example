# ─────────────────────────────────────────────────────────────────────────────
# No Competition Community → Supabase project (local machine)
# Copy to .env.local (cp .env.supabase.example .env.local). .env.local is never
# committed (".env*" in .gitignore). Never paste these
# values into chat, issues or code. Fill the empty values, then run:
#     npm run supabase:check -- --auth-roundtrip
#     npm run db:migrate
#     npm run supabase:bootstrap
#     npm run dev            → http://localhost:3000/register
# Where each value is: docs/SUPABASE-SETUP.md
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=development
APP_URL=http://localhost:3000
AUTH_PROVIDER=supabase
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=ncc-files
# 1 = one-click demo accounts on /login and /demo. Leave 0 unless you seed demo data (APP_ENV=demo npm run db:seed).
DEMO_MODE=0

# Paste every value exactly as the Supabase dashboard shows it — nothing to edit.

# [1] Dashboard → Connect → copy the connection string (Transaction or Session pooler),
#     WITH [YOUR-PASSWORD] still in it. SECRET.
DATABASE_URL=

# [2] The database password (Project Settings → Database → Reset database password if unknown).
#     It replaces [YOUR-PASSWORD] automatically, any characters allowed. SECRET.
SUPABASE_DB_PASSWORD=

# [3] Project Settings → API Keys → Project URL. Not secret.
NEXT_PUBLIC_SUPABASE_URL=

# [4] Project Settings → API Keys → Publishable key (sb_publishable_…). Not secret.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# [5] Project Settings → API Keys → Secret keys (sb_secret_…). SECRET: server only, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional: a separate migration connection. Normally derived (session pooler, port 5432).
DATABASE_MIGRATION_URL=

# Optional — only for AUTH_PROVIDER=local. With Supabase Auth, configure SMTP in the Supabase dashboard.
SMTP_URL=
EMAIL_FROM=

LOG_LEVEL=info
